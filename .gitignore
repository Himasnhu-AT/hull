bench/godot/.godot/
bench/results/

# Asset library: binaries are fetched on demand (scripts/assets.py fetch); the licence ledger is committed.
/assets/library/*
!/assets/library/LICENSES.json

# level file backups
*.level.ron.bak

# Agent worktrees and machine-local agent settings
.claude/worktrees/
.claude/settings.local.json
assets/cooked_demo/
