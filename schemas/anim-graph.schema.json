{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hull:schema:anim-graph",
  "type": "object",
  "required": [
    "kind",
    "layers"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "anim-graph"
    },
    "note": {
      "type": "string"
    },
    "params": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "number"
                },
                {
                  "type": "string",
                  "const": "boolean"
                },
                {
                  "type": "string",
                  "const": "trigger"
                }
              ],
              "x-ui": {
                "widget": "segments"
              }
            },
            "default": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "layers": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "start",
            "states"
          ],
          "properties": {
            "mask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "x-ui": {
                "help": "Bones this layer moves, with everything below them."
              }
            },
            "additive": {
              "type": "boolean",
              "default": false
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            },
            "weightFrom": {
              "type": "string",
              "x-ui": {
                "help": "A number parameter (0 to 1) that scales the layer's weight: turn a layer on and off from the game."
              }
            },
            "start": {
              "type": "string"
            },
            "states": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "object",
                  "properties": {
                    "clip": {
                      "type": "string",
                      "x-ui": {
                        "help": "Name of a clip in the anim-set."
                      }
                    },
                    "blend": {
                      "type": "object",
                      "required": [
                        "by",
                        "points"
                      ],
                      "properties": {
                        "by": {
                          "type": "string",
                          "x-ui": {
                            "help": "A number parameter."
                          }
                        },
                        "points": {
                          "type": "object",
                          "patternProperties": {
                            "^-?[0-9]+(\\.[0-9]+)?$": {
                              "type": "string"
                            }
                          },
                          "x-ui": {
                            "help": "Parameter value to clip."
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "blend2d": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "points"
                      ],
                      "properties": {
                        "x": {
                          "type": "string",
                          "x-ui": {
                            "help": "A number parameter for the sideways axis."
                          }
                        },
                        "y": {
                          "type": "string",
                          "x-ui": {
                            "help": "A number parameter for the forward axis."
                          }
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "x",
                              "y",
                              "clip"
                            ],
                            "properties": {
                              "x": {
                                "type": "number"
                              },
                              "y": {
                                "type": "number"
                              },
                              "clip": {
                                "type": "string",
                                "x-ui": {
                                  "help": "Name of a clip in the anim-set."
                                }
                              }
                            },
                            "additionalProperties": false
                          },
                          "minItems": 1,
                          "maxItems": 24,
                          "x-ui": {
                            "help": "Clips placed on the plane (a strafe space: idle at 0,0 and a walk in each direction). The clips are weighted by inverse distance to the parameters."
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "speedFrom": {
                      "type": "string",
                      "x-ui": {
                        "help": "A number parameter (ground speed). Playback is scaled so the feet match it; the rest is foot slide."
                      }
                    },
                    "speed": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 1
                    },
                    "exit": {
                      "type": "string",
                      "x-ui": {
                        "help": "State to go to when a clip that plays once has finished."
                      }
                    },
                    "exitBlend": {
                      "type": "number",
                      "minimum": 0,
                      "default": 0.1,
                      "x-ui": {
                        "unit": "s"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "x-ui": {
                      "help": "A state name, or * for any."
                    }
                  },
                  "to": {
                    "type": "string"
                  },
                  "when": {
                    "type": "string"
                  },
                  "blend": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0.15,
                    "x-ui": {
                      "unit": "s"
                    }
                  },
                  "after": {
                    "type": "number",
                    "minimum": 0,
                    "x-ui": {
                      "unit": "s",
                      "help": "Not before this long in the state."
                    }
                  },
                  "sync": {
                    "type": "boolean",
                    "default": false,
                    "x-ui": {
                      "help": "Start the new state at the same point of its cycle as the one it leaves (walk into run without the feet crossing wrongly)."
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "springs": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "chain"
          ],
          "properties": {
            "chain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "x-ui": {
                "help": "Bones from the root of the chain to its tip (hair, sash, tassel). They swing from the body's own movement."
              }
            },
            "stiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 120,
              "x-ui": {
                "unit": "1/s²",
                "help": "How hard the chain pulls back to its pose. The tip is softer."
              }
            },
            "damping": {
              "type": "number",
              "minimum": 0,
              "default": 7,
              "x-ui": {
                "unit": "1/s",
                "help": "How fast the swing dies away."
              }
            },
            "drive": {
              "type": "number",
              "minimum": 0,
              "default": 0.05,
              "x-ui": {
                "help": "Radians of swing per m/s² of acceleration of the chain's root."
              }
            },
            "falloff": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5,
              "default": 0.8,
              "x-ui": {
                "help": "Stiffness of each bone along the chain, relative to the one before it."
              }
            },
            "limitDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 180,
              "default": 70,
              "x-ui": {
                "unit": "deg"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "x-ui": {
        "help": "Spring-driven secondary motion. Springs run on frame time and only move the picture."
      }
    },
    "hitReact": {
      "type": "object",
      "properties": {
        "bones": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "number",
              "minimum": 0
            }
          },
          "x-ui": {
            "help": "Bone to its share of the flinch. Default: hips, spine, chest, neck, head."
          }
        },
        "angle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.35,
          "x-ui": {
            "unit": "rad",
            "help": "Lean of a full-strength hit, summed over the bones."
          }
        },
        "shift": {
          "type": "number",
          "minimum": 0,
          "default": 0.05,
          "x-ui": {
            "unit": "m",
            "help": "How far the hips are pushed along the hit."
          }
        },
        "stiffness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 220
        },
        "damping": {
          "type": "number",
          "minimum": 0,
          "default": 16
        }
      },
      "additionalProperties": false
    },
    "ik": {
      "type": "object",
      "properties": {
        "grips": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "required": [
                "socket"
              ],
              "properties": {
                "socket": {
                  "type": "string",
                  "x-ui": {
                    "help": "A socket of the character the hand holds, such as the hilt."
                  }
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1
                },
                "weightFrom": {
                  "type": "string",
                  "x-ui": {
                    "help": "A number parameter (0 to 1) that scales the weight."
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "x-ui": {
            "help": "Hand bone to the socket it grips: two-bone IK puts the off-hand on the hilt whatever the clip does."
          }
        },
        "feet": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxStep": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.35,
              "x-ui": {
                "unit": "m",
                "help": "Most a foot is moved to meet the ground, for a 1.78 m body; scales with height."
              }
            }
          },
          "additionalProperties": false
        },
        "look": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "weights": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "x-ui": {
                "help": "Bone to its share of the turn, base to tip."
              }
            },
            "yawDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 180,
              "default": 80
            },
            "pitchDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90,
              "default": 45
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 8,
              "x-ui": {
                "unit": "1/s",
                "help": "How fast the look weight follows."
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "Hull animation graph"
}
