{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hull:schema:anim-set",
  "type": "object",
  "required": [
    "kind",
    "clips"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "anim-set"
    },
    "note": {
      "type": "string"
    },
    "clips": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "keyframes"
                },
                {
                  "type": "string",
                  "const": "generated"
                },
                {
                  "type": "string",
                  "const": "gltf"
                }
              ],
              "x-ui": {
                "widget": "segments"
              }
            },
            "loop": {
              "type": "boolean",
              "default": false
            },
            "length": {
              "type": "number",
              "exclusiveMinimum": 0,
              "x-ui": {
                "unit": "s",
                "help": "Keyframes: required. Generated: overrides the generator's own length."
              }
            },
            "speed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "x-ui": {
                "help": "Playback multiplier."
              }
            },
            "travel": {
              "type": "number",
              "minimum": 0,
              "x-ui": {
                "unit": "m/s",
                "help": "Ground speed the feet in this clip are authored for. Lets a graph match playback to speed and report foot slide."
              }
            },
            "curve": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "smooth"
                },
                {
                  "type": "string",
                  "const": "linear"
                }
              ],
              "default": "smooth",
              "x-ui": {
                "widget": "segments"
              }
            },
            "generator": {
              "type": "string",
              "x-ui": {
                "help": "humanoid/idle, humanoid/walk, humanoid/run, procedural/breathe, procedural/sway, or one registered in code."
              }
            },
            "knobs": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "number"
                }
              }
            },
            "tracks": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "object",
                  "properties": {
                    "rotation": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "minItems": 3,
                                "maxItems": 3,
                                "items": false
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": false
                          },
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "minItems": 3,
                                "maxItems": 3,
                                "items": false
                              },
                              {
                                "enum": [
                                  "smooth",
                                  "linear",
                                  "in",
                                  "out",
                                  "inOut",
                                  "snap",
                                  "hold"
                                ]
                              }
                            ],
                            "minItems": 3,
                            "maxItems": 3,
                            "items": false
                          }
                        ]
                      },
                      "minItems": 1,
                      "x-ui": {
                        "help": "[time, [x, y, z]] in seconds and radians."
                      }
                    },
                    "offset": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "minItems": 3,
                                "maxItems": 3,
                                "items": false
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "items": false
                          },
                          {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "minItems": 3,
                                "maxItems": 3,
                                "items": false
                              },
                              {
                                "enum": [
                                  "smooth",
                                  "linear",
                                  "in",
                                  "out",
                                  "inOut",
                                  "snap",
                                  "hold"
                                ]
                              }
                            ],
                            "minItems": 3,
                            "maxItems": 3,
                            "items": false
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "x-ui": {
                "help": "Bone name to its keyframes."
              }
            },
            "windows": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "anyOf": [
                    {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "number",
                          "minimum": 0
                        }
                      ],
                      "minItems": 2,
                      "maxItems": 2,
                      "items": false
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "number",
                            "minimum": 0
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "items": false
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "x-ui": {
                "help": "Named time ranges [start, end] the game reads with animator.inWindow(name): hit, parry, iframe, cancel, trace. 0 to 1 of the loop for looping clips, seconds otherwise."
              }
            },
            "rootMotion": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "bone": {
                      "type": "string",
                      "default": "hips",
                      "x-ui": {
                        "help": "The bone whose travel is the character's travel."
                      }
                    },
                    "axes": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "xz"
                        },
                        {
                          "type": "string",
                          "const": "xyz"
                        },
                        {
                          "type": "string",
                          "const": "y"
                        }
                      ],
                      "default": "xz",
                      "x-ui": {
                        "widget": "segments",
                        "help": "Which offset axes of the bone move the node. The rest stay in the pose."
                      }
                    },
                    "turn": {
                      "type": "boolean",
                      "default": false,
                      "x-ui": {
                        "help": "The bone's rotation about Y turns the node too."
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "x-ui": {
                "help": "The root bone's travel moves the node (when the Animator has applyRootMotion) instead of the body inside it. true = hips, x and z."
              }
            },
            "events": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "x-ui": {
                "help": "0 to 1 of the loop for looping clips, seconds otherwise."
              }
            },
            "clip": {
              "type": "string",
              "x-ui": {
                "help": "gltf only: the name of an animation in the character's glTF body file. Defaults to the clip's own name."
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false,
  "title": "Hull animation set"
}
