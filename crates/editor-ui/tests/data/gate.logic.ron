// A gate: it opens when something walks in (or E is pressed), counts its openings in a
// variable, calls a script and a command, and closes after a while.
Graph(
    name: "gate",
    vars: [(name: "opens", ty: Number, default: Num(0.0)), (name: "locked", ty: Bool, default: Bool(false))],
    comments: [(text: "open sequence", pos: (300.0, -70.0), size: (1160.0, 420.0), color: (70, 100, 150))],
    nodes: [
        (id: 1, kind: OverlapEnter, pos: (0.0, 0.0)),
        (id: 2, kind: Action("open_door"), pos: (0.0, 200.0)),
        (id: 3, kind: Delay(secs: 0.5), pos: (330.0, 20.0)),
        (id: 4, kind: GetVar("locked"), pos: (330.0, 170.0)),
        (id: 5, kind: Not, pos: (520.0, 170.0)),
        (id: 6, kind: Branch, pos: (700.0, 20.0)),
        (id: 7, kind: Set(path: "Door.open"), defaults: [("value", Bool(true))], pos: (950.0, 20.0)),
        (id: 8, kind: Script(file: "score.ruspy", function: "on_open", args: ["who"]), pos: (1250.0, 20.0)),
        (id: 9, kind: Command(id: "time.scale", params: {"scale": "$scale"}), defaults: [("scale", Num(1.0))], pos: (950.0, 230.0)),
        (id: 10, kind: SetVar("opens"), pos: (1250.0, 260.0)),
        (id: 11, kind: GetVar("opens"), pos: (950.0, 420.0)),
        (id: 12, kind: Math(Add), defaults: [("b", Num(1.0))], pos: (1250.0, 420.0)),
        (id: 20, kind: OverlapExit, pos: (0.0, 520.0)),
        (id: 21, kind: Delay(secs: 2.0), pos: (330.0, 520.0)),
        (id: 22, kind: Set(path: "Door.open"), defaults: [("value", Bool(false))], pos: (600.0, 520.0)),
        (id: 23, kind: Log, defaults: [("text", Str("gate closed"))], pos: (940.0, 520.0)),
    ],
    flow: [
        (from: (1, "then"), to: (3, "in")),
        (from: (2, "then"), to: (3, "in")),
        (from: (3, "then"), to: (6, "in")),
        (from: (6, "true"), to: (7, "in")),
        (from: (7, "then"), to: (8, "in")),
        (from: (8, "then"), to: (9, "in")),
        (from: (9, "then"), to: (10, "in")),
        (from: (20, "then"), to: (21, "in")),
        (from: (21, "then"), to: (22, "in")),
        (from: (22, "then"), to: (23, "in")),
    ],
    data: [
        (from: (4, "value"), to: (5, "a")),
        (from: (5, "result"), to: (6, "cond")),
        (from: (1, "other"), to: (8, "who")),
        (from: (11, "value"), to: (12, "a")),
        (from: (12, "result"), to: (10, "value")),
    ],
)
