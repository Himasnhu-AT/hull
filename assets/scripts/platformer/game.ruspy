// Autoload "Game": score, health and the round state. Reach it with get_node("/Game").
signal("score_changed");   // (score, total)
signal("hp_changed");      // (hp, max_hp)
signal("state_changed");   // (state)  "playing" | "won" | "lost"

state = "playing";
score = 0;
total = 0;
max_hp = 3;
hp = 3;
stats = {"stomps": 0, "shards": 0, "hurt": 0};

// The pause key keeps working while paused: its own always-on input context.
fn _ready() {
    add_action("pf_pause", "pf_ui");
    action_add_key("pf_pause", "KeyP");
    push_input_context("pf_ui");
}

fn set_total(n) {
    total = n;
    emit_signal("score_changed", score, total);
}

fn add_score(points) {
    if state != "playing" {
        return;
    }
    score += points;
    stats["shards"] += 1;
    emit_signal("score_changed", score, total);
}

fn on_stomp() {
    stats.stomps += 1;
    score += 2;
    emit_signal("score_changed", score, total);
}

// Player.hurt -> here (connected in Player._ready).
fn on_player_hurt() {
    if state != "playing" {
        return;
    }
    hp -= 1;
    stats["hurt"] += 1;
    emit_signal("hp_changed", hp, max_hp);
    if hp <= 0 {
        state = "lost";
        emit_signal("state_changed", state);
    }
}

// Goal.reached -> here (connected in the level file).
fn win() {
    if state != "playing" {
        return;
    }
    state = "won";
    emit_signal("state_changed", state);
}

fn restart() {
    score = 0;
    hp = max_hp;
    state = "playing";
    stats = {"stomps": 0, "shards": 0, "hurt": 0};
    set_tree_paused(false);
    change_scene("levels/platformer.level.ron");
}
