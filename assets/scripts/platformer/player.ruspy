// The runner: a kinematic capsule moved with move_and_slide (Godot CharacterBody3D).
signal("hurt");
signal("landed");

// @export_range(2, 14, 0.5)
// @tooltip Run speed in metres per second
speed = 7.0;
// @export_range(4, 18, 0.5)
jump_speed = 11.0;
// @export_range(10, 50, 1)
gravity = 28.0;
// @export_color
tint = [0.2, 0.75, 0.7];
// @export_enum("normal", "floaty")
mode = "normal";

vx = 0.0;
vy = 0.0;
coyote = 0.0;
invulnerable = 0.0;
ground = null;          // the body under the feet (raycast), moving platforms read it
facing = 1.0;
was_floor = false;
spawn = [0.0, 1.0, 0.0];

fn _ready() {
    add_to_group("player");
    add_body("kinematic", "capsule", [0.8, 1.8, 0.8]);
    self.spawn = self.position;
    game = get_node("/Game");
    connect("hurt", game, "on_player_hurt");
    if mode == "floaty" {
        gravity = gravity * 0.5;
    }
}

fn _physics_process(dt) {
    // Where is the floor? A downward ray from the feet doubles as the coyote check.
    p = self.position;
    hit = raycast([p[0], p[1], p[2]], [p[0], p[1] - 1.5, p[2]], self);
    ground = null;
    gap = 99.0;
    if hit != null {
        ground = hit[0];
        gap = hit[3] - 0.9;
    }

    on_floor = is_on_floor();
    if on_floor || gap < 0.12 {
        coyote = 0.12;
    } else {
        coyote -= dt;
    }
    if on_floor {
        if vy < 0.0 {
            vy = 0.0;
        }
        if !was_floor {
            emit_signal("landed");
        }
    } else {
        vy -= gravity * dt;
    }
    was_floor = on_floor;

    axis = get_axis("pf_left", "pf_right");
    vx = axis * speed;
    if axis != 0.0 {
        facing = axis;
    }
    if is_action_just_pressed("pf_jump") && coyote > 0.0 {
        vy = jump_speed;
        coyote = 0.0;
        play_sound("jump");
    }

    v = move_and_slide([vx, vy, 0.0]);
    vy = v[1];
    if is_on_ceiling() && vy > 0.0 {
        vy = 0.0;
    }
    self.position = [self.position[0], self.position[1], 0.0];

    if invulnerable > 0.0 {
        invulnerable -= dt;
    }
    if self.position[1] < -8.0 {
        respawn();
        emit_signal("hurt");
    }
}

// Enemies call this on contact; a short blink of immunity follows.
fn take_hit(from_x) {
    if invulnerable > 0.0 {
        return;
    }
    invulnerable = 1.2;
    vy = 7.0;
    emit_signal("hurt");
    t = tween();
    tween_property(t, "color", [1.0, 0.3, 0.3], 0.1);
    tween_property(t, "color", tint, 0.4);
}

fn bounce() {
    vy = 9.0;
}

fn respawn() {
    self.position = spawn;
    vy = 0.0;
    invulnerable = 1.0;
}
