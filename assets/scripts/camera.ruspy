// Follows the player from a raised, slightly tilted view. Eased with a frame-rate
// independent lerp so the keeper drifts a little ahead of the lens.
offset = [0.0, 7.0, 10.0];
follow = 3.0;
player = null;

fn _process(dt) {
    if is_null(player) {
        player = get_node_or_null("/Player");
        if is_null(player) {
            return;
        }
    }
    t = get_global_position(player);
    p = get_position();
    k = clampf(follow * dt, 0.0, 1.0);
    np = [lerp(p[0], t[0] + offset[0], k), lerp(p[1], t[1] + offset[1], k), lerp(p[2], t[2] + offset[2], k)];
    set_position(np);
    look_at([np[0] - offset[0], 0.5, np[2] - offset[2]]);
}
