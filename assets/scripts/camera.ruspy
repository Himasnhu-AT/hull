// Follows the player from a raised, slightly tilted view. Eased with a frame-rate
// independent lerp so the keeper drifts a little ahead of the lens.
offset = vec3(0.0, 7.0, 10.0);
follow = 3.0;
player = null;

fn _process(dt) {
    if is_null(player) {
        player = get_node_or_null("/Player");
        if is_null(player) {
            return;
        }
    }
    k = clampf(follow * dt, 0.0, 1.0);
    np = self.position.lerp(player.global_position + offset, k);
    self.position = np;
    look_at(vec3(np.x - offset.x, 0.5, np.z - offset.z));
}
