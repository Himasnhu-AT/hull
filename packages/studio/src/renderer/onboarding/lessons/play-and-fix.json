{
  "title": "Play and fix",
  "lang": "en",
  "steps": [
    {
      "title": "Play your game",
      "say": "You play the real game inside Hull, in its own window.",
      "ops": [
        {"op":"write","id":"t","x":800,"y":48,"text":"Play and fix","size":56,"anchor":"middle"},
        {"op":"rect","id":"win","x":160,"y":260,"w":760,"h":420,"color":"ink"},
        {"op":"write","id":"win-t","x":540,"y":279.1,"text":"your game","size":34,"color":"gray","anchor":"middle"},
        {"op":"line","id":"gnd","x1":160,"y1":610,"x2":920,"y2":610,"color":"gray"},
        {"op":"ellipse","id":"plr","cx":360,"cy":550,"rx":40,"ry":60,"color":"blue","fill":"blue"},
        {"op":"rect","id":"enm","x":660,"y":550,"w":80,"h":60,"color":"red","fill":"red"}
      ]
    },
    {
      "title": "Freeze it",
      "say": "When something feels off, press Something is off, or the N key. The game freezes on the spot.",
      "ops": [
        {"op":"rect","id":"pill","x":1000,"y":310,"w":540,"h":100,"color":"red","fill":"red"},
        {"op":"write","id":"pill-t","x":1270,"y":339.9,"text":"Something is off (N)","size":38,"anchor":"middle"},
        {"op":"line","id":"pa","x1":1000,"y1":360,"x2":930,"y2":380,"color":"ink","arrow":true},
        {"op":"path","id":"bars","d":"M 500 350 L 500 450 M 580 350 L 580 450","color":"blue","width":18},
        {"op":"write","id":"frz","x":1000,"y":470,"text":"The game stops\nright there.","size":40}
      ]
    },
    {
      "title": "The moment goes with your note",
      "say": "Hull keeps the moment: a screenshot, the time, and what just played. It goes to the builder with your note.",
      "ops": [
        {"op":"erase","ids":["frz"]},
        {"op":"rect","id":"card","x":1000,"y":450,"w":540,"h":320,"color":"ink"},
        {"op":"write","id":"card-t","x":1270,"y":470.9,"text":"The moment","size":36,"anchor":"middle"},
        {"op":"rect","id":"shot","x":1030,"y":540,"w":180,"h":110,"color":"gray"},
        {"op":"write","id":"shot-t","x":1120,"y":580.2,"text":"screenshot","size":30,"color":"gray","anchor":"middle"},
        {"op":"write","id":"time","x":1230,"y":550,"text":"the time","size":34},
        {"op":"write","id":"played","x":1230,"y":602,"text":"what just played","size":34},
        {"op":"write","id":"mynote","x":1030,"y":690,"text":"and your note","size":38,"color":"blue"}
      ]
    },
    {
      "title": "Pick the piece",
      "say": "Pick the piece that is off, then press Change. The builder knows exactly what you mean.",
      "ops": [
        {"op":"erase","ids":["card","card-t","shot","shot-t","time","played","mynote"]},
        {"op":"ellipse","id":"sel","cx":360,"cy":550,"rx":62,"ry":82,"color":"blue"},
        {"op":"write","id":"sel-t","x":330,"y":382,"text":"this piece","size":34,"color":"blue","anchor":"middle"},
        {"op":"rect","id":"chg","x":1000,"y":470,"w":320,"h":100,"color":"ink","fill":"gray"},
        {"op":"write","id":"chg-t","x":1160,"y":495.6,"text":"Change","size":46,"anchor":"middle"},
        {"op":"write","id":"how","x":1000,"y":620,"text":"Pick a piece,\nthen press Change.","size":40}
      ]
    },
    {
      "title": "The builder edits that piece",
      "say": "The builder changes only that piece, with the same safe tools, and the change is recorded in the history.",
      "ops": [
        {"op":"erase","ids":["how","chg","chg-t"]},
        {"op":"rect","id":"bd","x":1000,"y":490,"w":540,"h":150,"color":"green","fill":"green"},
        {"op":"write","id":"bd-t","x":1270,"y":541.7,"text":"The builder","size":44,"anchor":"middle"},
        {"op":"path","id":"bp","d":"M 1000 640 C 900 810, 400 810, 360 640","color":"green","arrow":true},
        {"op":"write","id":"bd-s","x":1270,"y":670.9,"text":"edits only that piece","size":36,"anchor":"middle"}
      ]
    },
    {
      "title": "You see it live",
      "say": "The change shows in the running game at once. If it is still off, say so again.",
      "ops": [
        {"op":"erase","ids":["bars","bp","bd-s","sel","sel-t"]},
        {"op":"path","id":"arc","d":"M 360 490 C 400 350, 480 350, 520 490","color":"green","arrow":true,"dash":true},
        {"op":"write","id":"ok","x":540,"y":728.8,"text":"Now it jumps just as you asked.","size":40,"color":"green","anchor":"middle"},
        {"op":"write","id":"again","x":1270,"y":730.9,"text":"Still off? Say so again.","size":36,"anchor":"middle"}
      ]
    }
  ]
}
