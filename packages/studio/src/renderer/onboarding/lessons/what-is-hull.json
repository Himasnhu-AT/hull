{
  "title": "What Hull is",
  "lang": "en",
  "steps": [
    {
      "title": "Say it in a sentence",
      "say": "You describe the game you want in one sentence. The builder, an AI, answers with a few questions.",
      "ops": [
        {"op":"write","id":"t","x":800,"y":48,"text":"What Hull is","size":56,"anchor":"middle"},
        {"op":"ellipse","id":"p-head","cx":130,"cy":350,"rx":30,"ry":34,"color":"ink"},
        {"op":"path","id":"p-body","d":"M 130 384 L 130 490 M 70 425 L 190 425 M 130 490 L 85 570 M 130 490 L 175 570","color":"ink"},
        {"op":"write","id":"p-lbl","x":130,"y":607,"text":"you","size":34,"anchor":"middle"},
        {"op":"rect","id":"bub","x":260,"y":280,"w":720,"h":210,"color":"blue","fill":"blue"},
        {"op":"write","id":"bub-t","x":620,"y":340.2,"text":"\"A first-person arena where\nwaves of drones come at me.\"","size":38,"anchor":"middle"},
        {"op":"rect","id":"bld","x":1120,"y":280,"w":400,"h":210,"color":"green","fill":"green"},
        {"op":"write","id":"bld-t","x":1320,"y":337.7,"text":"The builder","size":42,"anchor":"middle"},
        {"op":"write","id":"bld-s","x":1320,"y":403,"text":"an AI","size":34,"color":"gray","anchor":"middle"},
        {"op":"line","id":"a1","x1":980,"y1":385,"x2":1120,"y2":385,"color":"ink","arrow":true},
        {"op":"write","id":"asks","x":1320,"y":552,"text":"asks a few questions","size":34,"anchor":"middle"},
        {"op":"write","id":"q","x":1320,"y":610,"text":"?","size":60,"color":"red","anchor":"middle"}
      ]
    },
    {
      "title": "It writes the brief",
      "say": "From your answers it writes a short brief, GAME.md, in plain words. You read it, ask for changes, and approve it.",
      "ops": [
        {"op":"erase","ids":["p-head","p-body","p-lbl","bub","bub-t","bld","bld-t","bld-s","a1","asks","q"]},
        {"op":"rect","id":"b2","x":100,"y":380,"w":340,"h":150,"color":"green","fill":"green"},
        {"op":"write","id":"b2-t","x":270,"y":433.8,"text":"The builder","size":40,"anchor":"middle"},
        {"op":"line","id":"a2","x1":440,"y1":455,"x2":620,"y2":455,"color":"ink","arrow":true},
        {"op":"rect","id":"doc","x":620,"y":250,"w":400,"h":480,"color":"ink"},
        {"op":"write","id":"doc-t","x":820,"y":292.4,"text":"GAME.md","size":52,"anchor":"middle"},
        {"op":"path","id":"doc-l","d":"M 670 410 L 970 410 M 670 480 L 940 480 M 670 550 L 970 550 M 670 620 L 900 620","color":"gray","width":4},
        {"op":"write","id":"doc-n","x":1110,"y":380,"text":"You read it,\nask for changes,\nthen approve.","size":40}
      ]
    },
    {
      "title": "It builds in stages",
      "say": "Then it builds the game one stage at a time: the world, the characters, the animations and the rules.",
      "ops": [
        {"op":"erase","ids":["b2","b2-t","a2","doc","doc-t","doc-l","doc-n"]},
        {"op":"rect","id":"st0","x":55,"y":310,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"st0-t","x":215,"y":355.9,"text":"World","size":36,"anchor":"middle"},
        {"op":"rect","id":"st1","x":445,"y":310,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"st1-t","x":605,"y":355.9,"text":"Characters","size":36,"anchor":"middle"},
        {"op":"rect","id":"st2","x":835,"y":310,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"st2-t","x":995,"y":355.9,"text":"Animations","size":36,"anchor":"middle"},
        {"op":"rect","id":"st3","x":1225,"y":310,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"st3-t","x":1385,"y":355.9,"text":"Rules","size":36,"anchor":"middle"},
        {"op":"line","id":"sa0","x1":383,"y1":375,"x2":437,"y2":375,"color":"ink","arrow":true},
        {"op":"line","id":"sa1","x1":773,"y1":375,"x2":827,"y2":375,"color":"ink","arrow":true},
        {"op":"line","id":"sa2","x1":1163,"y1":375,"x2":1217,"y2":375,"color":"ink","arrow":true}
      ]
    },
    {
      "title": "Every stage is checked",
      "say": "Sounds, effects and screens follow. Each stage is checked before the next one starts.",
      "ops": [
        {"op":"rect","id":"sb0","x":250,"y":520,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"sb0-t","x":410,"y":565.9,"text":"Sounds","size":36,"anchor":"middle"},
        {"op":"rect","id":"sb1","x":640,"y":520,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"sb1-t","x":800,"y":565.9,"text":"Effects","size":36,"anchor":"middle"},
        {"op":"rect","id":"sb2","x":1030,"y":520,"w":320,"h":130,"color":"blue","fill":"blue"},
        {"op":"write","id":"sb2-t","x":1190,"y":565.9,"text":"Screens","size":36,"anchor":"middle"},
        {"op":"line","id":"sc0","x1":578,"y1":585,"x2":632,"y2":585,"color":"ink","arrow":true},
        {"op":"line","id":"sc1","x1":968,"y1":585,"x2":1022,"y2":585,"color":"ink","arrow":true},
        {"op":"path","id":"ticks","d":"M 323 346 L 338 362 L 365 328 M 713 346 L 728 362 L 755 328 M 1103 346 L 1118 362 L 1145 328 M 1493 346 L 1508 362 L 1535 328 M 518 556 L 533 572 L 560 538 M 908 556 L 923 572 L 950 538 M 1298 556 L 1313 572 L 1340 538","color":"green","width":7},
        {"op":"write","id":"chk","x":800,"y":728.8,"text":"A green tick means the stage was checked.","size":40,"anchor":"middle"}
      ]
    },
    {
      "title": "You play it",
      "say": "When the stages are done, you play the game right here in Hull.",
      "ops": [
        {"op":"erase","ids":["st0","st0-t","st1","st1-t","st2","st2-t","st3","st3-t","sa0","sa1","sa2","sb0","sb0-t","sb1","sb1-t","sb2","sb2-t","sc0","sc1","ticks","chk"]},
        {"op":"rect","id":"win","x":240,"y":260,"w":800,"h":430,"color":"ink"},
        {"op":"write","id":"win-t","x":640,"y":279.1,"text":"your game","size":34,"color":"gray","anchor":"middle"},
        {"op":"line","id":"gnd","x1":240,"y1":610,"x2":1040,"y2":610,"color":"gray"},
        {"op":"ellipse","id":"plr","cx":460,"cy":545,"rx":38,"ry":62,"color":"blue","fill":"blue"},
        {"op":"rect","id":"enm","x":800,"y":550,"w":70,"h":60,"color":"red","fill":"red"},
        {"op":"write","id":"play","x":1300,"y":450.7,"text":"you play it","size":44,"anchor":"middle"},
        {"op":"line","id":"pa","x1":1170,"y1":474,"x2":1055,"y2":474,"color":"ink","arrow":true}
      ]
    },
    {
      "title": "You say what is off",
      "say": "You tell the builder what feels wrong, in your own words. It changes the game and you play again.",
      "ops": [
        {"op":"erase","ids":["play","pa"]},
        {"op":"rect","id":"note","x":1120,"y":280,"w":420,"h":150,"color":"blue","fill":"blue"},
        {"op":"write","id":"note-t","x":1330,"y":310.2,"text":"\"The jump feels\nfloaty.\"","size":38,"anchor":"middle"},
        {"op":"line","id":"na","x1":1330,"y1":430,"x2":1330,"y2":530,"color":"ink","arrow":true},
        {"op":"rect","id":"bd","x":1120,"y":530,"w":420,"h":130,"color":"green","fill":"green"},
        {"op":"write","id":"bd-t","x":1330,"y":572.7,"text":"The builder","size":42,"anchor":"middle"},
        {"op":"path","id":"ret","d":"M 1330 660 C 1330 830, 640 830, 640 700","color":"green","arrow":true},
        {"op":"write","id":"ret-t","x":985,"y":722,"text":"it fixes it, you play again","size":34,"color":"green","anchor":"middle"}
      ]
    },
    {
      "title": "One file, web and desktop",
      "say": "The finished game builds to one JavaScript file. It runs in a browser and as a desktop app.",
      "ops": [
        {"op":"erase","ids":["win","win-t","gnd","plr","enm","note","note-t","na","bd","bd-t","ret","ret-t"]},
        {"op":"rect","id":"gj","x":140,"y":350,"w":420,"h":200,"color":"ink"},
        {"op":"write","id":"gj-t","x":350,"y":407.4,"text":"game.js","size":52,"anchor":"middle"},
        {"op":"write","id":"gj-s","x":350,"y":483,"text":"one JavaScript file","size":34,"color":"gray","anchor":"middle"},
        {"op":"rect","id":"web","x":900,"y":250,"w":560,"h":160,"color":"blue","fill":"blue"},
        {"op":"write","id":"web-t","x":1180,"y":305.6,"text":"On the web","size":46,"anchor":"middle"},
        {"op":"rect","id":"dsk","x":900,"y":490,"w":560,"h":160,"color":"green","fill":"green"},
        {"op":"write","id":"dsk-t","x":1180,"y":545.6,"text":"On the desktop","size":46,"anchor":"middle"},
        {"op":"line","id":"wa","x1":568,"y1":410,"x2":892,"y2":340,"color":"ink","arrow":true},
        {"op":"line","id":"da","x1":568,"y1":490,"x2":892,"y2":560,"color":"ink","arrow":true}
      ]
    }
  ]
}
