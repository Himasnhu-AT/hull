---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Code from '../../components/Code.astro';
import { games, code } from '../../data/site';
import type { ImageMetadata } from 'astro';
import shroudFight from '../../assets/shots/shroud-firefight.webp';
import shroudSetup from '../../assets/shots/shroud-setup.webp';
import shroudHigh from '../../assets/shots/shroud-office-high.webp';
import shroudWon from '../../assets/shots/shroud-round-won.webp';
import shroudMetrics from '../../assets/shots/shroud-metrics.webp';
import shroudPause from '../../assets/shots/shroud-pause.webp';
import shroudDepot from '../../assets/shots/shroud-depot.webp';
import courierRoad from '../../assets/shots/courier-road.webp';
import courierMenu from '../../assets/shots/courier-menu.webp';
import courierShift from '../../assets/shots/courier-shift.webp';
import courierCamera from '../../assets/shots/courier-settings-camera.webp';
import courierPause from '../../assets/shots/courier-pause.webp';
import courierResults from '../../assets/shots/courier-results.webp';
import courierMetrics from '../../assets/shots/courier-metrics.webp';
import courierTown from '../../assets/shots/courier-town.webp';

type Img = { src: ImageMetadata; alt: string; cap: string };
type Case = {
  hero: Img;
  description: string;
  context: string[];
  numbers: { value: string; label: string; from?: string }[];
  engine: { label: string; hint: string }[];
  kept: { label: string; hint: string }[];
  lessonsTitle: string;
  lessons: { label: string; hint: string }[];
  gallery: Img[];
  snippet?: { code: string; file: string };
};

const cases: Record<string, Case> = {
  shroud: {
    hero: { src: shroudFight, alt: 'Shroud: a firefight in a desert yard, the player aiming over a low wall at two squad members, HUD with health and ammo', cap: 'Shroud, mid firefight' },
    description: 'Shroud is an indoor FPS with an AI squad that evolves from your past matches. Porting it onto Hull cut its game code from 13,467 to 7,833 lines.',
    context: [
      'Shroud is a first-person shooter where the enemy squad is bred from the squads that did best against you. Traits evolve with a genetic algorithm, tactics come from a utility AI, combat moves from NEAT networks, and a player model records where you camp and how you strafe.',
      'It was the first game on the engine. Its control port, offscreen capture, perf overlay and session log moved into the engine, and its dark theme and arena sun became the engine defaults.',
    ],
    numbers: [
      { from: '13,467', value: '7,833', label: 'lines of game code, before and after the port' },
      { value: '3', label: 'sub-states of its own under InGame: Playing, Evolving, Debrief' },
    ],
    engine: [
      { label: 'App shell and states', hint: 'Boot, MainMenu and InGame from the engine; Shroud adds Playing, Evolving and Debrief as sub-states.' },
      { label: 'Menus, settings and pause', hint: 'Main menu, match setup screen, pause header with the score, the whole settings screen.' },
      { label: 'FpsController', hint: 'Walk 5, sprint 8, jump 6.5, crouch to 1.2 m, eye at 1.65 m. Weapon systems run after FpsSet::Move.' },
      { label: 'Devtools', hint: 'Control port, offscreen capture, perf overlay, session log and trace. Shroud deleted its own copies.' },
      { label: 'Audio', hint: 'SoundLibrary variants for every sound effect, an ambience loop, muting in test runs.' },
    ],
    kept: [
      { label: 'The brain', hint: 'A pure Rust crate with no Bevy: arena and navigation, the trait genome, NEAT, the player model, utility AI and a 2D trainer sim.' },
      { label: 'Its look', hint: 'Exposure, AgX tone mapping, distance fog and atmosphere on its own camera. The engine only sets quality, MSAA and FOV.' },
      { label: 'Its settings section', hint: 'Difficulty, map, crosshair colour, crosshair size and squad callouts, as FieldDefs on Gameplay and HUD tabs.' },
      { label: 'Its game commands', hint: 'game.state, player.*, enemy.*, ai.* and sim.* stay in Shroud; old names are aliased to the engine’s.' },
    ],
    lessonsTitle: 'What the render budget does here',
    lessons: [
      { label: 'Nothing, at High', hint: 'Arenas are small, so at High nothing is far enough to change. On Low (×0.6) props fade past 36 m and big blocks go flat past 48 m.' },
      { label: 'Two tags recommended', hint: 'Tag the player and enemy roots Actor, so an enemy standing still in its first second is never treated as scenery.' },
    ],
    gallery: [
      { src: shroudSetup, alt: 'Shroud match setup: difficulty cards from Recruit to Elite, map cards for Foundry, Depot and Office, a Start match button', cap: 'Match setup, a screen the game registers' },
      { src: shroudPause, alt: 'Shroud paused mid match: score header, Resume selected, settings, restart, main menu and quit', cap: 'Pause menu with the match score' },
      { src: shroudHigh, alt: 'Shroud office map at High quality: desks, monitors and lit ceiling panels', cap: 'Office map' },
      { src: shroudDepot, alt: 'Shroud Depot map: three squad members in a sandy yard between concrete walls', cap: 'The squad on the Depot map' },
      { src: shroudWon, alt: 'Shroud round won banner over a desert yard, score 1 to 0', cap: 'Round won' },
      { src: shroudMetrics, alt: 'Shroud in the metrics window with its own keys: AI think time and enemies alive next to the engine keys', cap: 'Its own keys in the metrics window' },
    ],
  },
  courier: {
    hero: { src: courierRoad, alt: 'Courier: a hover bike on the open road through a green valley, lakes and low-poly pines, speed 97 on the HUD', cap: 'Courier, open road' },
    description: 'Courier is a hover-bike delivery game across a 1.28 km procedural valley, built on Hull to see whether the engine fits a game nothing like Shroud.',
    context: [
      'Hover-bike parcel delivery across a 1.28 km procedural valley: eight towns, ten farms, roads, lakes, forests and a mountain rim. Pick up parcels, deliver before par and keep your streak alive until the shift clock runs out. Everything is procedural; there are no asset files.',
      'It was built to test the engine on something unlike Shroud: third person, open map, driving. Everything it needed that a third game would also need went into the engine.',
    ],
    numbers: [
      { value: '~3,150', label: 'lines of game code, on the engine’s ~14,300' },
      { value: '8.3 ms', label: 'average frame' },
      { value: '~1,120', label: 'of 7,835 meshes drawn' },
    ],
    engine: [
      { label: 'Menus and screens', hint: 'MenuConfig, a shift-select and a records screen with register_screen, and a sticky results screen.' },
      { label: 'Settings', hint: 'Its own CourierSettings section with Gameplay and Camera tabs ahead of the engine’s Controls, Video and Audio.' },
      { label: 'SceneryStream', hint: 'About 9,000 props streamed by cell. Colliders are spawned once, outside streaming.' },
      { label: 'Metrics, control port, trace', hint: 'courier.* control commands and its own metrics keys behind the dev feature.' },
    ],
    kept: [
      { label: 'Terrain and props', hint: 'Noise, the fixed map layout of towns, farms and roads, and where every house, tree and rock stands.' },
      { label: 'The bike', hint: 'Hover physics on avian: ray hover, steering, grip, boost, hop and reset.' },
      { label: 'Shift rules', hint: 'Jobs, par times, scoring, streaks and records, pure and tested.' },
    ],
    lessonsTitle: 'What the engine gained from it',
    lessons: [
      { label: 'ChaseCamera', hint: 'Third-person follow for any root entity: trails the heading, looks ahead, orbits with the mouse and pulls in front of walls.' },
      { label: 'MeshKit', hint: 'Low-poly vertex-coloured meshes from primitives, for games with no models.' },
      { label: 'DataDir JSON saves', hint: 'Records saved next to settings.json with the same atomic writes and corrupt-file handling.' },
      { label: 'SunSetup', hint: 'Open maps need shadows to about 300 m with 4 cascades; the arena sun stopped at 90 m.' },
      { label: 'Two gotchas, now documented', hint: 'A game names bevy in its own Cargo.toml so derives resolve. SpatialQuery plus a mutable Position query needs a ParamSet.' },
    ],
    gallery: [
      { src: courierMenu, alt: 'Courier main menu in yellow: Start shift selected, records, settings, quit, over a valley flyover', cap: 'Main menu, accent re-branded' },
      { src: courierShift, alt: 'Courier shift select: Sprint, Standard and Marathon cards with Standard selected, a steering assist toggle', cap: 'Shift select, a registered screen' },
      { src: courierCamera, alt: 'Courier camera settings: distance, height and swing speed sliders', cap: 'Its own Camera tab' },
      { src: courierTown, alt: 'Courier: riding into a town square with houses and a silo, the next stop named at the top', cap: 'Crowe’s Silo, a pickup stop' },
      { src: courierPause, alt: 'Courier paused on the road: Resume selected, restart shift, settings, main menu, quit', cap: 'Pause menu' },
      { src: courierMetrics, alt: 'Courier in the metrics window: frame, CPU, GPU and memory charts and a runs table', cap: 'Metrics window' },
    ],
    snippet: { code: code.menu, file: 'courier/src/menus.rs' },
  },
};

export function getStaticPaths() {
  return games.map((g) => ({ params: { slug: g.slug } }));
}
const { slug } = Astro.params;
const g = games.find((x) => x.slug === slug)!;
const c = cases[slug!];
const other = games.find((x) => x.slug !== slug)!;
const otherHero = other.slug === 'shroud' ? shroudDepot : courierTown;
const closer: Record<string, { code: string; file: string }> = {
  shroud: { file: 'shroud/crates/game/src/main.rs', code: `fn info() -> GameInfo {
    GameInfo::new("shroud", "Shroud")
        .tagline("They learn from you.")
        .version(env!("CARGO_PKG_VERSION"))
}` },
  courier: { file: 'courier/src/main.rs', code: `fn main() {
    engine::app(courier::info())
        .add_plugins((
            SettingsPlugin::<CourierSettings>::default(),
            courier::CourierPlugin,
        ))
        .run();
}` },
};
const ld = { '@context': 'https://schema.org', '@type': 'VideoGame', name: g.title, description: c.description, genre: g.kind, gamePlatform: 'PC', applicationCategory: 'Game' };
---
<Base title={g.title} state={g.title} accent={g.accent} footerTitle="Yours<br />is third" footerLede="Two games and the shell held. What it lacked for Courier went into the engine for everyone." footerCode={closer[slug!].code} footerFile={closer[slug!].file} description={c.description} jsonLd={ld}>
  <article>
    <header class="gc-hero wrap">
      <div class="grid">
        <a class="label gc-back" href="/#games" data-screen="Games">Games</a>
        <span class="eyebrow gc-eyebrow" data-reveal="fade" data-intro>{g.kind}</span>
        <h1 class="display gc-title" data-split="chars" data-intro>{g.title}</h1>
        <p class="lede gc-tag">{g.tagline} {g.summary}</p>
      </div>
    </header>
    <div class="wrap gc-media" data-reveal="clip" data-intro data-delay="0.1">
      <Shot frameClass="gc-media__frame" src={c.hero.src} alt={c.hero.alt} caption={c.hero.cap} sizes="100vw" eager />
    </div>

    <section class="wrap section" aria-labelledby="ctx">
      <div class="grid">
        <h2 id="ctx" class="label gc-label">The game</h2>
        <div class="body gc-ctx">{c.context.map((p) => <p>{p}</p>)}</div>
        <dl class="gc-nums">
          {c.numbers.map((n) => (
            <div class="gc-num"><dd class="gc-num__v num">{n.from && <s><span class="sr-only">from </span>{n.from}</s>}<span>{n.from && <span class="sr-only">to </span>}{n.value}</span></dd><dt class="gc-num__l">{n.label}</dt></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="wrap section--tight" aria-labelledby="split">
      <div class="grid">
        <h2 id="split" class="h-xl gc-split-title" data-split="lines">Where the line falls</h2>
        <div class="gc-col">
          <h3 class="label gc-col__h"><span class="gc-dot"></span>From the engine</h3>
          <ul class="rows" data-select-rows>{c.engine.map((r, i) => <li class:list={['row', i === 0 && 'is-sel']}><div class="row__text"><span class="row__label">{r.label}</span><span class="row__hint">{r.hint}</span></div></li>)}</ul>
        </div>
        <div class="gc-col gc-col--b">
          <h3 class="label gc-col__h"><span class="gc-dot gc-dot--game"></span>In {g.title}</h3>
          <ul class="rows" data-select-rows>{c.kept.map((r, i) => <li class:list={['row', i === 0 && 'is-sel']}><div class="row__text"><span class="row__label">{r.label}</span><span class="row__hint">{r.hint}</span></div></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="gal">
      <div class="grid">
        <h2 id="gal" class="label gc-label">Screens</h2>
        <div class="gallery">
          {c.gallery.map((s, i) => <Shot class={`gallery__i gallery__i--${i}`} src={s.src} alt={s.alt} caption={s.cap} sizes="(min-width: 768px) 45vw, 100vw" />)}
        </div>
      </div>
    </section>

    <section class="wrap section--tight" aria-labelledby="les">
      <div class="grid">
        <h2 id="les" class="h-l gc-les-title" data-split="lines">{c.lessonsTitle}</h2>
        <ul class="rows gc-les" data-select-rows>{c.lessons.map((r, i) => <li class:list={['row', i === 0 && 'is-sel']}><div class="row__text"><span class="row__label">{r.label}</span><span class="row__hint">{r.hint}</span></div></li>)}</ul>
        {c.snippet && <div class="gc-code"><Code code={c.snippet.code} file={c.snippet.file} /></div>}
      </div>
    </section>

    <nav class="wrap gc-next" aria-label="Next game">
      <a href={`/games/${other.slug}/`} data-screen={other.title} class="next" style={`--game:${other.accent}`}>
        <span class="label">Next game</span>
        <span class="next__title"><span class="next__name">{other.title}</span><svg class="next__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" fill="none"/></svg></span>
        <span class="next__kind">{other.kind}. {other.tagline}</span>
        <Shot class="next__shot" src={otherHero} alt="" sizes="(min-width: 768px) 40vw, 100vw" />
      </a>
    </nav>
  </article>
</Base>

<style>
  .gc-hero { padding-top: clamp(7.5rem, 13vw, 11rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .gc-back { grid-column: 1 / -1; position: relative; isolation: isolate; overflow: clip; display: inline-flex; align-items: center; gap: 0.6em; min-height: 2rem; padding: 0 0.7em 0 0.6em; border-radius: 3px; justify-self: start; margin-bottom: 1.5rem; background: var(--c-raised); color: var(--c-fg); transition: color 0.28s var(--ease-soft); }
  .gc-back::before { content: ''; width: 0.45em; height: 0.45em; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; rotate: 45deg; transition: translate 0.3s var(--ease-soft); }
  .gc-back::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent); scale: 0 1; transform-origin: right; transition: scale 0.34s var(--ease-soft); }
  @media (hover: hover) { .gc-back:hover { color: var(--c-on-accent); } .gc-back:hover::after { scale: 1 1; } .gc-back:hover::before { translate: -0.25em 0; } }
  .gc-back:focus-visible { color: var(--c-on-accent); } .gc-back:focus-visible::after { scale: 1 1; }
  .gc-eyebrow { grid-column: 1 / -1; margin-bottom: 0.8rem; }
  .gc-title { grid-column: 1 / span 8; }
  .gc-tag { grid-column: 9 / -1; align-self: end; }
  .gc-media { margin-bottom: 1rem; }
  .gc-media :global(.gc-media__frame) { aspect-ratio: 21 / 9; }
  .gc-media :global(.gc-media__frame img) { object-position: 50% 72%; }
  .gc-label { grid-column: 1 / span 2; padding-top: 0.4rem; }
  .gc-ctx { grid-column: 3 / span 6; font-size: var(--t-body); }
  .gc-ctx p:first-child { color: var(--c-fg); font-size: var(--t-m); line-height: 1.4; }
  .gc-nums { grid-column: 10 / -1; display: grid; gap: 1.6rem; align-content: start; }
  .gc-num { display: grid; gap: 0.2rem; padding-left: 1rem; border-left: 3px solid var(--accent); }
  .gc-num__v { font-family: var(--f-display); font-weight: 700; font-size: var(--t-xl); line-height: 0.9; display: flex; gap: 0.4em; align-items: baseline; flex-wrap: wrap; }
  .gc-num__v s { color: var(--c-dim); font-size: 0.55em; font-weight: 600; text-decoration-thickness: 2px; }
  .gc-num__l { color: var(--c-muted); font-size: var(--t-s); }
  .gc-split-title { grid-column: 1 / -1; margin-bottom: 2.5rem; }
  .gc-col { grid-column: 1 / span 6; }
  .gc-col--b { grid-column: 7 / span 6; }
  .gc-col__h { display: flex; align-items: center; gap: 0.6em; margin-bottom: 1rem; }
  .gc-dot { width: 0.6rem; height: 0.6rem; border-radius: 1px; background: var(--c-fg); }
  .gc-dot--game { background: var(--accent); }
  .gallery { grid-column: 3 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem) var(--gutter); }
  .gallery :global(.gallery__i--1), .gallery :global(.gallery__i--3), .gallery :global(.gallery__i--5) { margin-top: clamp(0rem, 3vw, 2.5rem); }
  .gc-les-title { grid-column: 1 / span 4; }
  .gc-les { grid-column: 5 / -1; }
  .gc-code { grid-column: 5 / -1; margin-top: 2rem; min-width: 0; }
  .gc-next { margin-top: clamp(3rem, 6vw, 5rem); }
  .next { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 0.4rem; align-items: end; padding-top: 2rem; border-top: 1px solid var(--c-line-strong); }
  .next .label { grid-column: 1 / span 6; }
  .next__title { grid-column: 1 / span 7; justify-self: start; position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: 0.25em; padding: 0.06em 0.3em 0 0.12em; margin-left: -0.12em; font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: clamp(3.5rem, 1rem + 8.5vw, 10rem); line-height: 0.84; transition: color 0.3s; }
  .next__title::before { content: ''; position: absolute; inset: 0; z-index: -1; border-left: 4px solid var(--game); background: linear-gradient(90deg, color-mix(in srgb, var(--game) 55%, var(--c-bg)), color-mix(in srgb, var(--game) 18%, var(--c-bg))); border-radius: 0 var(--radius) var(--radius) 0; scale: 0 1; transform-origin: left; transition: scale 0.45s var(--ease-soft); }
  .next__arrow { width: 0.42em; height: 0.42em; color: var(--game); translate: -0.2em 0; opacity: 0.5; transition: translate 0.45s var(--ease-soft), opacity 0.3s; }
  .next__kind { grid-column: 1 / span 7; color: var(--c-muted); }
  .next :global(.next__shot) { grid-column: 8 / -1; grid-row: 1 / span 3; }
  .next :global(.next__shot img) { transition: scale 0.6s var(--ease-out); }
  @media (hover: hover) {
    .next:hover .next__title::before { scale: 1 1; }
    .next:hover .next__arrow { translate: 0.15em 0; opacity: 1; color: var(--c-fg); }
    .next:hover :global(.next__shot img) { scale: 1.045; }
  }
  .next:focus-visible .next__title::before { scale: 1 1; }
  .next:focus-visible .next__arrow { translate: 0.15em 0; opacity: 1; }

  @media (max-width: 767px) {
    .gc-title, .gc-tag, .gc-label, .gc-ctx, .gc-nums, .gc-col, .gc-col--b, .gallery, .gc-les-title, .gc-les, .gc-code { grid-column: 1 / -1; }
    .gc-title { font-size: clamp(4.5rem, 24vw, 7rem); }
    .gc-tag { margin-top: 1.2rem; }
    .gc-ctx { margin-top: 0.6rem; }
    .gc-nums { margin-top: 2rem; }
    .gc-col--b { margin-top: 2.5rem; }
    .gallery { grid-template-columns: 1fr; }
    .gallery :global(.gallery__i--1), .gallery :global(.gallery__i--3), .gallery :global(.gallery__i--5) { margin-top: 0; }
    .gc-les { margin-top: 1.5rem; }
    .next { grid-template-columns: 1fr; }
    .next .label, .next__title, .next__kind, .next :global(.next__shot) { grid-column: 1; grid-row: auto; }
    .next__title { font-size: clamp(4rem, 22vw, 6rem); }
    .next :global(.next__shot) { margin-top: 1.2rem; }
  }
</style>
