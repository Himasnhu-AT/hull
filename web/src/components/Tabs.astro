---
// The engine's settings screen as a page section: tabs with an accent underline, rows with a value
// chip, and a side panel ("About this tab") with a real capture or a measured number.
import Shot from './Shot.astro';
import { doc, type Tab } from '../data/site';
import type { ImageMetadata } from 'astro';

type TabShot = { src: ImageMetadata; alt: string; cap: string; source?: string; formats?: ('avif' | 'webp')[] };
interface Props { tabs: Tab[]; shots: Partial<Record<string, TabShot>>; label: string }
const { tabs, shots, label } = Astro.props;
---
<div class="tabs" data-tabs>
  <div class="tablist" role="tablist" aria-label={label}>
    {tabs.map((t, i) => (
      <button class="tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">{t.label}</button>
    ))}
    <span class="tablist__line" data-tab-line aria-hidden="true"></span>
  </div>
  {tabs.map((t) => {
    const s = shots[t.id];
    return (
      <div class="tabpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`}>
        <h3 class="tabpanel__title">{t.label}</h3>
        <ul class="rows" data-select-rows>
          {t.rows.map((r, j) => (
            <li class:list={['row', j === 0 && 'is-sel']}>
              <div class="row__text">
                <span class="row__label">{r.label}</span>
                <span class="row__hint">{r.hint}</span>
                {r.code && <code class="row__code">{r.code}</code>}
              </div>
              <span class="chip">{r.value}</span>
            </li>
          ))}
        </ul>
        <aside class="about panel" aria-label={`About ${t.label}`}>
          <span class="label" data-about-label>About this tab</span>
          <p class="about__title" data-about-title>{t.title}</p>
          <p class="about__text" data-about-text>{t.about}</p>
          {s && <Shot src={s.src} alt={s.alt} caption={s.cap} source={s.source} sizes="(min-width: 1024px) 28vw, 100vw" widths={[480, 800, 1280]} formats={s.formats ?? ['avif', 'webp']} quality={60} />}
          {t.stat && (
            <p class:list={['about__stat', !s && 'about__stat--big']}>
              <b class="num">{t.stat.value}</b>
              <span>{t.stat.label}</span>
            </p>
          )}
          {(t.feature || t.doc) && (
            <p class="about__meta">
              {t.feature && <span>Feature <code>{t.feature}</code></span>}
              {t.doc && <a class="link" href={doc(t.doc)} rel="noopener">{t.doc}</a>}
            </p>
          )}
        </aside>
      </div>
    );
  })}
  <div class="keys tabs__keys" aria-hidden="true"><span><span class="kbd">Q / E</span> Switch tab</span></div>
</div>

<style>
  .tabs { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .tablist { grid-column: 1 / -1; position: relative; display: flex; gap: clamp(0.25rem, 1.2vw, 1.4rem); margin-left: -0.55em; border-bottom: 1px solid var(--c-line-strong); margin-bottom: 2rem; overflow-x: auto; scrollbar-width: none; }
  .tab { position: relative; isolation: isolate; padding: 0.7rem 0.55em 0.8rem; font-weight: 600; font-size: clamp(1.1rem, 0.95rem + 0.5vw, 1.5rem); letter-spacing: 0.04em; color: var(--c-muted); white-space: nowrap; transition: color 0.2s; }
  .tab[aria-selected='true'] { color: var(--c-fg); }
  .tab::before { content: ''; position: absolute; inset: 0.3rem 0 0.4rem; z-index: -1; border-left: 3px solid var(--accent); background: var(--accent-bar); border-radius: 0 var(--radius) var(--radius) 0; scale: 0 1; transform-origin: left; transition: scale 0.3s var(--ease-soft); }
  @media (hover: hover) { .tab:hover { color: var(--c-fg); } .tab:hover::before { scale: 1 1; } }
  .tab:focus-visible::before { scale: 1 1; }
  .tablist__line { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--accent); }
  :global(html:not(.js)) .tablist { display: none; }
  .tabpanel { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 1.5rem; align-items: start; }
  :global(html:not(.js)) .tabpanel { margin-bottom: 3rem; }
  .tabpanel[hidden] { display: none; }
  .tabpanel__title { grid-column: 1 / -1; font-family: var(--f-display); text-transform: uppercase; font-weight: 700; font-size: 1.5rem; }
  .is-tabs .tabpanel__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .tabpanel .rows { grid-column: 1 / span 8; }
  .about { grid-column: 9 / -1; padding: 1.2rem 1.2rem 1.3rem; display: grid; gap: 0.5rem; position: sticky; top: 6rem; }
  .about__title { font-family: var(--f-display); font-weight: 700; text-transform: uppercase; font-size: 1.6rem; line-height: 1; }
  .about__text { color: var(--c-muted); font-size: var(--t-s); margin-bottom: 0.6rem; }
  .about__stat { display: grid; gap: 0.15rem; padding-top: 0.8rem; margin-top: 0.2rem; border-top: 1px solid var(--c-line); }
  .about__stat b { font-family: var(--f-display); font-weight: 700; font-size: 1.6rem; line-height: 1; color: var(--accent); }
  .about__stat span { color: var(--c-muted); font-size: var(--t-xs); }
  .about__stat--big b { font-size: clamp(2.6rem, 1.6rem + 2.4vw, 3.6rem); line-height: 0.9; }
  .about__stat--big span { font-size: var(--t-s); }
  .about__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem; margin-top: 0.4rem; font-size: var(--t-xs); color: var(--c-muted); }
  .about__meta code { color: var(--c-fg); font-size: 0.8125rem; }
  .about__meta a { display: inline-flex; align-items: center; min-height: 1.5rem; padding-block: 0.15rem; }
  .tabs__keys { grid-column: 1 / -1; margin-top: 1.8rem; }

  @media (max-width: 1023px) {
    .tabpanel .rows { grid-column: 1 / span 7; }
    .about { grid-column: 8 / -1; }
  }
  @media (max-width: 767px) {
    /* Phones: every tab stays visible on two or three lines; the selected one keeps its bar. */
    .tablist { flex-wrap: wrap; gap: 0.2rem 0.3rem; margin-left: 0; padding-bottom: 0.5rem; overflow: visible; }
    .tab { font-size: 1.05rem; padding: 0.5rem 0.6em 0.55rem; }
    .tab[aria-selected='true']::before { scale: 1 1; }
    .tablist__line { display: none; }
    .tabpanel .rows, .about { grid-column: 1 / -1; }
    .about { position: static; }
    .tabs__keys { display: none; }
  }
</style>
