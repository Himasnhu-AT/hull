---
// One frame family: 16:9 real captures, AVIF/WebP at several widths.
// The flat-shaded engine captures compress better as WebP than AVIF, so those pass formats={['webp']}.
// Side-panel shots cap `widths` (and the fallback width) at what the layout can show.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
type Format = 'avif' | 'webp';
interface Props { src: ImageMetadata; alt: string; caption?: string; source?: string; sizes?: string; eager?: boolean; class?: string; frameClass?: string; widths?: number[]; formats?: Format[]; quality?: number }
const { src, alt, caption, source, sizes = '(min-width: 768px) 60vw, 100vw', eager = false, class: cls = '', frameClass = '', widths = [640, 960, 1440, 1920], formats = ['avif', 'webp'], quality = 70 } = Astro.props;
const width = Math.min(src.width, Math.max(...widths));
---
<figure class:list={['shot', cls]}>
  <div class:list={['shot__frame', frameClass]}>
    <Picture src={src} alt={alt} formats={formats} fallbackFormat="webp" widths={widths} width={width} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" quality={quality} />
    <slot />
  </div>
  {(caption || source) && <figcaption>{caption && <span>{caption}</span>}{source && <code>{source}</code>}</figcaption>}
</figure>
