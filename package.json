{
  "name": "hull-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "app": "pnpm --filter @hull/studio app",
    "app:web": "pnpm --filter @hull/studio web",
    "project:check": "tsx scripts/project.ts check",
    "project:build": "tsx scripts/project.ts build",
    "project:dev": "tsx scripts/project.ts dev",
    "project:run": "tsx scripts/project.ts",
    "mcp": "node packages/tools/bin/hull-mcp.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
