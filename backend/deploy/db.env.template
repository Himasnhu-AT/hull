# /etc/hull-backend/db.env  (root:hull, mode 0640). SECRET: the URL holds the database password.
# verify-full checks the server's certificate and name against the RDS CA bundle (download it once, keep it at that path).
DATABASE_URL=postgres://hull:<password>@<host>:5432/hull?sslmode=verify-full&sslrootcert=/etc/hull-backend/rds-ca.pem
# Optional: keep the tables in their own schema inside the database. Default is public.
# DATABASE_SCHEMA=public
