# /etc/hull-backend/backend.env  (root:hull, mode 0640). Replace every <placeholder>. Secrets are marked.

# Where the server listens and the address people use to reach it. https turns on the Secure cookie flag.
PUBLIC_URL=https://api.marlstudio.com
ADDR=127.0.0.1:8787
# Community game files. The systemd unit sets this too.
DATA_DIR=/var/lib/hull-backend

# The reverse proxy in front (Caddy on this host). Only its X-Forwarded-For is believed.
TRUSTED_PROXIES=127.0.0.1

# Web origins allowed to call POST /api/waitlist from a browser (comma separated).
SITE_ORIGINS=https://marlstudio.com,https://www.marlstudio.com

# Accounts (comma separated) that may open /admin after signing in at /login. Empty means nobody.
ADMIN_EMAILS=<you@yourdomain.com>

# false closes account sign-up.
ALLOW_SIGNUP=true

# AI. SECRET: the owner's key.
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_MODEL=claude-opus-5-5
ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Input plus output tokens one user may use per UTC day (0 = no cap).
DAILY_TOKEN_BUDGET=2000000
# AI requests per user per minute (0 = no cap).
AI_REQUESTS_PER_MINUTE=30

# Google sign-in: set both or neither. GOOGLE_CLIENT_SECRET is a SECRET.
# Redirect URI to register: https://api.marlstudio.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
