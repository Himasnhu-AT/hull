{
  "kind": "input-map",
  "note": "WASD moves relative to the camera, the mouse turns it, Shift sprints, Space dodges, F or left click cuts, R or right click is the heavy (hold to charge), Q blocks (tap just before a blow to deflect), Tab or C changes stance, T or middle click locks on, E changes target, L changes the look, Esc pauses.",
  "actions": {
    "move": {
      "type": "axis2",
      "keys": {
        "up": [
          "W"
        ],
        "down": [
          "S"
        ],
        "left": [
          "A"
        ],
        "right": [
          "D"
        ]
      },
      "pad": "stickL"
    },
    "look": {
      "type": "axis2",
      "mouse": "delta"
    },
    "lookPad": {
      "type": "axis2",
      "keys": {
        "up": [
          "ArrowUp"
        ],
        "down": [
          "ArrowDown"
        ],
        "left": [
          "ArrowLeft"
        ],
        "right": [
          "ArrowRight"
        ]
      },
      "pad": "stickR"
    },
    "sprint": {
      "type": "button",
      "keys": [
        "ShiftLeft"
      ],
      "pad": "stickLPress"
    },
    "dodge": {
      "type": "button",
      "keys": [
        "Space"
      ],
      "pad": "east"
    },
    "attack": {
      "type": "button",
      "keys": [
        "Mouse0",
        "KeyF"
      ],
      "pad": "west"
    },
    "heavy": {
      "type": "button",
      "keys": [
        "Mouse2",
        "KeyR"
      ],
      "pad": "triggerR"
    },
    "block": {
      "type": "button",
      "keys": [
        "KeyQ"
      ],
      "pad": "triggerL"
    },
    "stance": {
      "type": "button",
      "keys": [
        "Tab",
        "KeyC"
      ],
      "pad": "north"
    },
    "lockOn": {
      "type": "button",
      "keys": [
        "KeyT",
        "Mouse1"
      ],
      "pad": "stickRPress"
    },
    "looks": {
      "type": "button",
      "keys": [
        "KeyL"
      ],
      "pad": "back"
    },
    "pause": {
      "type": "button",
      "keys": [
        "Escape",
        "KeyP"
      ],
      "pad": "start",
      "rebind": false
    },
    "lockNext": {
      "type": "button",
      "keys": [
        "KeyE"
      ]
    }
  },
  "groups": {
    "Move": [
      "move",
      "sprint",
      "dodge"
    ],
    "Look": [
      "look",
      "lookPad",
      "lockOn",
      "lockNext"
    ],
    "Fight": [
      "attack",
      "heavy",
      "block",
      "stance"
    ],
    "Game": [
      "looks",
      "pause"
    ]
  }
}
