{
  "kind": "anim-graph",
  "note": "Ashblade: a trigger per move (named like the clip), full-body in the base layer and the same clip on the upper body so the arms win over the walk swing.",
  "params": {
    "speed": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 12
    },
    "dead": {
      "type": "boolean",
      "default": false
    },
    "guarding": {
      "type": "boolean",
      "default": false
    },
    "broken": {
      "type": "boolean",
      "default": false
    },
    "hit": {
      "type": "trigger"
    },
    "stagger": {
      "type": "trigger"
    },
    "dodge": {
      "type": "trigger"
    },
    "cancel": {
      "type": "trigger"
    },
    "backstep": {
      "type": "trigger"
    },
    "sword-cut": {
      "type": "trigger"
    },
    "sword-cross": {
      "type": "trigger"
    },
    "sword-feint": {
      "type": "trigger"
    }
  },
  "layers": {
    "base": {
      "start": "idle",
      "states": {
        "idle": {
          "clip": "idle"
        },
        "move": {
          "blend": {
            "by": "speed",
            "points": {
              "1.44": "walk",
              "4.82": "run"
            }
          },
          "speedFrom": "speed"
        },
        "dead": {
          "clip": "death"
        },
        "back-step": {
          "clip": "back-step",
          "exit": "idle",
          "exitBlend": 0.12
        },
        "sword-cut": {
          "clip": "sword-cut",
          "exit": "idle",
          "exitBlend": 0.12
        },
        "sword-cross": {
          "clip": "sword-cross",
          "exit": "idle",
          "exitBlend": 0.12
        },
        "sword-feint": {
          "clip": "sword-feint",
          "exit": "idle",
          "exitBlend": 0.12
        }
      },
      "transitions": [
        {
          "from": "*",
          "to": "dead",
          "when": "dead",
          "blend": 0.12
        },
        {
          "from": "*",
          "to": "back-step",
          "when": "backstep",
          "blend": 0.06
        },
        {
          "from": "*",
          "to": "sword-cut",
          "when": "sword-cut",
          "blend": 0.05
        },
        {
          "from": "*",
          "to": "sword-cross",
          "when": "sword-cross",
          "blend": 0.05
        },
        {
          "from": "*",
          "to": "sword-feint",
          "when": "sword-feint",
          "blend": 0.05
        },
        {
          "from": "sword-cut",
          "to": "idle",
          "when": "cancel",
          "blend": 0.1
        },
        {
          "from": "sword-cross",
          "to": "idle",
          "when": "cancel",
          "blend": 0.1
        },
        {
          "from": "sword-feint",
          "to": "idle",
          "when": "cancel",
          "blend": 0.1
        },
        {
          "from": "idle",
          "to": "move",
          "when": "speed > 0.3",
          "blend": 0.15
        },
        {
          "from": "move",
          "to": "idle",
          "when": "speed < 0.2",
          "blend": 0.2
        }
      ]
    },
    "upper": {
      "mask": [
        "spine",
        "armL",
        "armR",
        "head"
      ],
      "start": "hold",
      "states": {
        "hold": {
          "clip": "hold-sword"
        },
        "hit": {
          "clip": "hit",
          "exit": "hold",
          "exitBlend": 0.1
        },
        "stagger": {
          "clip": "stagger",
          "exit": "hold",
          "exitBlend": 0.2
        },
        "back-step": {
          "clip": "back-step",
          "exit": "hold",
          "exitBlend": 0.12
        },
        "sword-cut": {
          "clip": "sword-cut",
          "exit": "hold",
          "exitBlend": 0.12
        },
        "sword-cross": {
          "clip": "sword-cross",
          "exit": "hold",
          "exitBlend": 0.12
        },
        "sword-feint": {
          "clip": "sword-feint",
          "exit": "hold",
          "exitBlend": 0.12
        }
      },
      "transitions": [
        {
          "from": "*",
          "to": "stagger",
          "when": "stagger",
          "blend": 0.05
        },
        {
          "from": "*",
          "to": "hit",
          "when": "hit",
          "blend": 0.04
        },
        {
          "from": "*",
          "to": "back-step",
          "when": "backstep",
          "blend": 0.06
        },
        {
          "from": "*",
          "to": "sword-cut",
          "when": "sword-cut",
          "blend": 0.05
        },
        {
          "from": "*",
          "to": "sword-cross",
          "when": "sword-cross",
          "blend": 0.05
        },
        {
          "from": "*",
          "to": "sword-feint",
          "when": "sword-feint",
          "blend": 0.05
        },
        {
          "from": "sword-cut",
          "to": "hold",
          "when": "cancel",
          "blend": 0.1
        },
        {
          "from": "sword-cross",
          "to": "hold",
          "when": "cancel",
          "blend": 0.1
        },
        {
          "from": "sword-feint",
          "to": "hold",
          "when": "cancel",
          "blend": 0.1
        }
      ]
    },
    "breath": {
      "additive": true,
      "weight": 0.8,
      "start": "on",
      "states": {
        "on": {
          "clip": "breathe"
        }
      }
    }
  },
  "ik": {
    "feet": {
      "enabled": true,
      "maxStep": 0.35
    }
  }
}
